#!/bin/zsh

#
# If numpy is not installed, try to install it
#

set -u


python='/Library/Application Support/MWorks/MWEL/.python'


# Since we don't pass --upgrade to ensurepip or pip, neither pip nor numpy will
# be touched if they're already installed
if "$python" -m ensurepip; then
    "$python" -m pip install numpy
fi

# Failure in this script shouldn't cause the overall MWorks installation to
# fail, so always indicate successful completion
exit 0
